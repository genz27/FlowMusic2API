FLOWMUSIC_HTTP_HOST=0.0.0.0
FLOWMUSIC_HTTP_BIND=127.0.0.1
FLOWMUSIC_HTTP_PORT=8000
FLOWMUSIC_ROOT=.
FLOWMUSIC_STATIC_DIR=./web/static
FLOWMUSIC_DATA_DIR=./data

# sqlite (default)
FLOWMUSIC_DB_DRIVER=sqlite
FLOWMUSIC_DATABASE_URL=

# postgres
# FLOWMUSIC_DB_DRIVER=postgres
# FLOWMUSIC_DATABASE_URL=
# FLOWMUSIC_POSTGRES_MAX_OPEN_CONNS=32

# docker-compose.yml PostgreSQL service credentials.
FLOWMUSIC_POSTGRES_HOST=postgres
FLOWMUSIC_POSTGRES_PORT=5432
FLOWMUSIC_POSTGRES_USER=flowmusic
FLOWMUSIC_POSTGRES_PASSWORD=flowmusic
FLOWMUSIC_POSTGRES_DB=flowmusic2api
FLOWMUSIC_POSTGRES_SSLMODE=disable

FLOWMUSIC_ADMIN_USER=admin
# Production must override these values.
FLOWMUSIC_ADMIN_PASSWORD=change-me-admin-password
FLOWMUSIC_DEFAULT_API_KEY=change-me-api-key
FLOWMUSIC_ADMIN_JWT_SECRET=change-me-long-random-secret

# Optional first account seed. Leave empty unless deploying with env-managed credentials.
FLOWMUSIC_INITIAL_ACCOUNT_EMAIL=
FLOWMUSIC_INITIAL_ACCOUNT_NAME=
FLOWMUSIC_INITIAL_ACCOUNT_REMARK=
FLOWMUSIC_INITIAL_PROTOCOL_MODE=
FLOWMUSIC_INITIAL_REFRESH_TOKEN=
FLOWMUSIC_INITIAL_FLOW_BEARER=
FLOWMUSIC_INITIAL_PROVIDER_TOKEN=
FLOWMUSIC_INITIAL_PROVIDER_REFRESH_TOKEN=
FLOWMUSIC_INITIAL_COOKIES=
FLOWMUSIC_INITIAL_ACCOUNT_PROXY_URL=
FLOWMUSIC_INITIAL_AUTO_REFRESH_ENABLED=true
FLOWMUSIC_INITIAL_REFRESH_INTERVAL_MINUTES=60

FLOWMUSIC_BASE_URL=https://www.flowmusic.app
FLOWMUSIC_SUPABASE_BASE_URL=https://sb.flowmusic.app
# Required when using refresh_token -> latest Bearer token.
# 从浏览器登录 flowmusic.app 后，在 HAR 文件的 POST sb.flowmusic.app/auth/v1/token?grant_type=pkce 请求头中提取 apikey 值
FLOWMUSIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVkbmpjY3FjbWJ4ZWF4YmlkaW5yIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE1NjEwNjQsImV4cCI6MjA4NzEzNzA2NH0.XCXSuL7Th1xHecfRrP0vAOFmKwJxwBqVFLu06SxtVzg
# Used when provider_refresh_token is refreshed through Google OAuth.
# The default client id is the public value observed in login all.har.
FLOWMUSIC_GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
FLOWMUSIC_GOOGLE_OAUTH_CLIENT_ID=1032626174130-533micbc9tgsei76mqhtguq07lpoe4je.apps.googleusercontent.com
# Set this if Google returns "client_secret is missing".
FLOWMUSIC_GOOGLE_OAUTH_CLIENT_SECRET=

# Optional upstream proxy.
FLOWMUSIC_PROXY_URL=
FLOWMUSIC_TLS_INSECURE_SKIP_VERIFY=false

# Timeouts / workers.
FLOWMUSIC_UPSTREAM_TIMEOUT_SECONDS=120
FLOWMUSIC_GENERATION_TIMEOUT_SECONDS=600
FLOWMUSIC_STREAM_IDLE_TIMEOUT_SECONDS=90
FLOWMUSIC_DISABLE_WORKERS=false
FLOWMUSIC_TOKEN_REFRESH_LEAD_SECONDS=600
FLOWMUSIC_TOKEN_REFRESH_INTERVAL_SECONDS=60
FLOWMUSIC_STORAGE_PRESIGN_SECONDS=604800

# Optional local cache directory.
FLOWMUSIC_CACHE_DIR=./tmp
FLOWMUSIC_CACHE_ENABLED=false
FLOWMUSIC_CACHE_TIMEOUT_SECONDS=7200
FLOWMUSIC_CACHE_BASE_URL=
FLOWMUSIC_CACHE_STORAGE_MODE=local

# Optional S3/R2 cache seed for first database initialization.
FLOWMUSIC_S3_ENDPOINT=
FLOWMUSIC_S3_REGION=
FLOWMUSIC_S3_BUCKET=
FLOWMUSIC_S3_ACCESS_KEY=
FLOWMUSIC_S3_SECRET_KEY=
FLOWMUSIC_S3_USE_SSL=true
FLOWMUSIC_S3_FORCE_PATH_STYLE=false
FLOWMUSIC_S3_PREFIX=
FLOWMUSIC_S3_PUBLIC_BASE_URL=

# Configure S3/R2 later in /manage -> system config -> cache.
# storage_mode=s3 or r2 supports Cloudflare R2 and any S3-compatible endpoint.

# Optional live contract test credentials. Keep empty unless running:
# go test ./internal/service -run TestLiveFlowMusicGenerationContract -count=1 -v
FLOWMUSIC_LIVE_TEST=0
FLOWMUSIC_LIVE_PROTOCOL_MODE=
FLOWMUSIC_LIVE_FLOW_BEARER=
FLOWMUSIC_LIVE_REFRESH_TOKEN=
FLOWMUSIC_LIVE_PROVIDER_TOKEN=
FLOWMUSIC_LIVE_PROVIDER_REFRESH_TOKEN=
FLOWMUSIC_LIVE_COOKIES=
FLOWMUSIC_LIVE_PROMPT=
